generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("MEMBER") // MEMBER | ADMIN
  bio          String?
  github       String?
  createdAt    DateTime @default(now())

  skills     Skill[]
  likes      SkillLike[]
  files      FileItem[]
  comments   Comment[]
  sites        Site[]
  siteLikes    SiteLike[]
  siteComments SiteComment[]
}

model Skill {
  id          String   @id @default(cuid())
  title       String
  summary     String
  content     String   // 프롬프트 본문 / 사용법 (Markdown 텍스트)
  category    String   // PROMPT | CLAUDE_SKILL | AGENT | WORKFLOW | TOOL
  tags        String   @default("") // 쉼표로 구분
  sourceUrl   String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    SkillLike[]
  comments Comment[]

  @@index([category])
  @@index([createdAt])
}

model SkillLike {
  userId  String
  skillId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model FileItem {
  id          String   @id @default(cuid())
  name        String   // 원본 파일명
  storedName  String   @unique // 로컬: 디스크 파일명 / Vercel: Blob URL
  mimeType    String
  size        Int
  folder      String   @default("일반") // 폴더(카테고리)
  description String?
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([folder])
}

// ── 동지 홈페이지 소개 게시판 ──
model Site {
  id          String   @id @default(cuid())
  title       String   // 사이트 이름
  url         String   // 사이트 주소 (http/https)
  summary     String   // 한 줄 소개
  description String   // 만든 이유, 주요 기능, 회고 등
  techStack   String   @default("") // 쉼표로 구분 (Next.js, Tailwind …)
  repoUrl     String?  // GitHub 저장소 (선택)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    SiteLike[]
  comments SiteComment[]

  @@index([createdAt])
}

model SiteLike {
  userId String
  siteId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site   Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

model SiteComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  siteId   String
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
